\NeedsTeXFormat{LaTeX2e}
\ProvidesExplClass{pfuproc}{2026/11/06}{0.1}
{Class for journal proceedings (sbornik bundle)}

\bool_new:N \g_pfuproc_twocolumn_bool
\bool_gset_false:N \g_pfuproc_twocolumn_bool

\keys_define:nn { pfuproc }
{
  paper     .code:n      = { \keys_set:nn { sbornik/paper } { paper    = #1 } },
  language  .code:n      = { \keys_set:nn { sbornik/lang  } { language = #1 } },
  theorems  .bool_set:N  = \g_sbornik_theorems_bool,
  theorems  .default:n   = true,
  twocolumn .bool_gset:N = \g_pfuproc_twocolumn_bool,
  twocolumn .default:n   = true,
}

\sbornik_font_declare_keys:n { pfuproc }

\DeclareUnknownKeyHandler
{ \PassOptionsToClass{\CurrentOption}{scrartcl} }

\ProcessKeyOptions[pfuproc]

\bool_if:NT \g_pfuproc_twocolumn_bool
{ \PassOptionsToClass{twocolumn}{scrartcl} }

\exp_args:Nx \PassOptionsToClass
{ paper=\sbornik_paper_koma: , fontsize=\g_sbornik_fontsize_tl }
{ scrartcl }
\LoadClass{scrartcl}

\sbornik_theorems_apply:
\sbornik_lang_apply:

